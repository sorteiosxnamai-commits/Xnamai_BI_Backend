# Supabase (Render = IPv4): use Transaction pooler URI from Connect (port 6543).
# User must be postgres.<project-ref>. URL-encode special chars in the password.
# Do not append ?pgbouncer=true or &supa=... — that breaks psycopg.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
MERCOS_ADAPTOR_URL=https://mercosadaptor.onrender.com
MERCOS_ADAPTOR_API_KEY=
BI_API_KEY=troque-por-uma-chave-forte
JWT_SECRET=troque-por-um-segredo-forte
AUTH_ADMIN_USERNAME=admin@xnamai.com
AUTH_ADMIN_PASSWORD=123456
CORS_ORIGINS=http://localhost:5173,https://xnamai-bi-frontend.vercel.app
SYNC_ORDERS_MINUTES=10
SYNC_CATALOG_MINUTES=30
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ERP Xnamai (tudo desligado por padrão; ver docs/erp/deployment.md) ---
ERP_ENABLED=false
ERP_CONNECTION_ID=xnamai
ERP_BOOTSTRAP_ADMINS=
ERP_ADAPTOR_API_KEY=
ERP_WRITE_CUSTOMERS=false
ERP_WRITE_ORDERS=false
ERP_WRITE_TITLES=false
ERP_WEBHOOK_SECRET_HEX=
ERP_JWT_SECRET=
ERP_ACCESS_MINUTES=15
ERP_REFRESH_DAYS=7
ERP_ALLOW_BI_OPERATOR_LINK=false
