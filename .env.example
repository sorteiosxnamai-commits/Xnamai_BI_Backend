# Supabase (Render = IPv4): use Transaction pooler URI from Connect (port 6543).
# User must be postgres.<project-ref>. URL-encode special chars in the password.
# Do not append ?pgbouncer=true or &supa=... — that breaks psycopg.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
MERCOS_ADAPTOR_URL=https://mercosadaptor.onrender.com
MERCOS_ADAPTOR_API_KEY=
BI_API_KEY=troque-por-uma-chave-forte
CORS_ORIGINS=http://localhost:5173,https://seu-front.onrender.com
SYNC_ORDERS_MINUTES=10
SYNC_CATALOG_HOURS=6
LOG_LEVEL=INFO
